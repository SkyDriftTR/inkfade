---
import Guide from '../layouts/Guide.astro';
import { groups } from '../data/piercing.js';
const base = import.meta.env.BASE_URL.endsWith('/') ? import.meta.env.BASE_URL : import.meta.env.BASE_URL + '/';
const faq = [
  { q: 'Piercing takımı ne zaman değiştirebilirim?', a: 'Bölge tamamen iyileşmeden takınızı değiştirmemenizi öneririz. İlk takı değişimini stüdyomuzda yapmanızı tavsiye ederiz; doğru ölçüyü ve malzemeyi birlikte belirleriz.' },
  { q: 'Piercing’in çevresinde şişlik oluştu, bu normal mi?', a: 'İlk günlerde hafif şişlik, kızarıklık ve şeffaf-beyazımsı bir akıntı görülmesi normaldir. Şişlik artıyorsa, iltihaplı bir akıntı ya da ateş varsa lütfen bir doktora başvurun ve bizi de bilgilendirin.' },
  { q: 'Piercing’le uyuyabilir miyim?', a: 'Evet; ancak özellikle kulak piercing’lerinde o tarafın üzerine yatmamaya özen göstermenizi öneririz. Seyahat yastığı kullanmak kulağa gelen baskıyı azaltır.' },
];
---
<Guide
  slug="piercing-bakimi"
  kicker="Rehber · Bakım"
  h1="Piercing bakımı nasıl yapılır?"
  lead="Yeni piercing’inizin sorunsuz iyileşmesi için yapılması gerekenler aslında oldukça sadedir: bölgeyi temiz tutmak, takıya dokunmamak ve süreci sabırla takip etmek. Günlük bakım adımlarını ve ortalama iyileşme sürelerini aşağıda bulabilirsiniz."
  faq={faq}
>
  <h2>Günlük bakım</h2>
  <ol class="guide-steps">
    <li><b>Ellerinizi yıkayın.</b> Piercing’e dokunmadan önce her zaman.</li>
    <li><b>Serum fizyolojikle temizleyin.</b> Günde iki kez steril serum fizyolojikle ıslattığınız temiz bir gazlı bezle bölgeyi nazikçe silin; kurumuş kabukları önce yumuşatıp ardından temizleyin.</li>
    <li><b>Kurulayın.</b> Tek kullanımlık kâğıt havluyla bastırarak kurulayın.</li>
    <li><b>Takıyı çevirmeyin.</b> Takıyı çevirmek ya da döndürmek iyileşmeyi geciktirir ve bölgeyi tahriş eder.</li>
  </ol>
  <p>Alkol, oksijenli su veya sert antiseptikler kullanmamanızı öneririz; bu ürünler dokuyu kurutarak iyileşmeyi yavaşlatır.</p>

  <h2>Ortalama iyileşme süreleri</h2>
  <div class="guide-table">
    {groups.map((g) => (
      <div>
        <p class="mono">{g.name}</p>
        <ul>
          {g.items.map((it) => (
            <li><span>{it.name}{it.note && <small> · {it.note}</small>}</span><span>{it.time}</span></li>
          ))}
        </ul>
      </div>
    ))}
  </div>
  <p>Bölge dışarıdan birkaç hafta içinde iyileşmiş gibi görünse de içerideki kanalın olgunlaşması daha uzun sürer. Bu nedenle takı değişimi için acele etmemenizi öneririz.</p>

  <h2>Dikkat etmeniz gerekenler</h2>
  <ul>
    <li>İyileşme süresince havuz, deniz, küvet ve saunadan uzak durun.</li>
    <li>Kulak piercing’lerinde telefonunuzu ve yastık kılıfınızı temiz tutun; saçınızı bölgeden uzak tutmaya özen gösterin.</li>
    <li>Dudak piercing’lerinde ilk günlerde sigara, alkol ve çok sıcak ya da acı yiyeceklerden kaçının; yemeklerden sonra ağzınızı alkolsüz bir gargarayla çalkalayın.</li>
    <li>Göbek piercing’inde bel kısmı sıkı olan kıyafetlerden kaçının.</li>
  </ul>
  <p>Hangi piercing’leri yaptığımızı ve uygulama sürecimizi <a href={`${base}sinop-piercing/`}>Sinop piercing sayfamızda</a> bulabilirsiniz. Piercing’in yanı sıra dövme de düşünüyorsanız <a href={base}>Sinop dövme ve piercing stüdyomuz Inkfade</a>’yi ziyaret edebilirsiniz.</p>
</Guide>
