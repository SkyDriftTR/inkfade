---
import Guide from '../layouts/Guide.astro';
import { works } from '../data/works.js';
const base = import.meta.env.BASE_URL.endsWith('/') ? import.meta.env.BASE_URL : import.meta.env.BASE_URL + '/';
const styles = [
  {
    name: 'Black & Grey Realism',
    ids: ['zeus', 'ozgurluk', 'catrina'],
    text: 'Stüdyomuzun uzmanlık alanıdır. Portre, heykel, hayvan ve mitoloji figürlerini siyah ve gri tonların yumuşak geçişleriyle, fotoğrafa yakın bir derinlikte işliyoruz. Ön kol, üst kol, baldır ve sırt gibi geniş ve düz bölgelerde en iyi sonucu verir.',
    fit: 'Detaylı ve uzaktan da etkisini gösteren bir çalışma isteyenler için.',
  },
  {
    name: 'Sleeve (tam kol, tam bacak)',
    ids: ['basmelek', 'melek-kafatasi', 'gotham'],
    text: 'Kolun ya da bacağın tamamını tek bir hikâye olarak kurguluyoruz. Çalışma birkaç seans sürer ve parçaların birbirine bağlanması için tasarım en başından bir bütün olarak planlanır. Böylece sonradan eklenen parçaların yarattığı dağınık görüntünün önüne geçilir.',
    fit: 'Büyük ve bütünlüklü bir proje planlayanlar için.',
  },
  {
    name: 'Oriental',
    ids: ['hannya', 'foo-dog-koi'],
    text: 'Hannya maskesi, koi ve foo dog gibi Uzak Doğu motiflerini güçlü konturlar ve black & grey gölgelendirmeyle kendi yorumumuzla çiziyoruz. Üst kol ve omuz gibi kavisli bölgelerde akıcı bir görünüm sağlar.',
    fit: 'Simgesel anlamı olan, karakterli bir dövme arayanlar için.',
  },
  {
    name: 'Sketch & Dotwork',
    ids: ['kirik-heykel', 'balance', 'spiderman'],
    text: 'Eskiz çizgileri, nokta gölgelendirme ve bilinçli olarak bırakılan kırılmalarla daha deneysel çalışmalar ortaya çıkarıyoruz. Realism’e göre daha hafif bir doku sunar; klasik bir figürü modern bir dille yorumlamak için idealdir.',
    fit: 'Alışılmışın dışında, sanatsal bir yorum isteyenler için.',
  },
  {
    name: 'Fine line & Minimal',
    ids: ['lale', 'gul', 'denizanasi'],
    text: 'İnce çizgiler, küçük boyutlar ve yer yer yumuşak renk geçişleri. Bilek, ön kol ve köprücük kemiği gibi bölgelere yakışır; ilk dövmesini yaptıracak misafirlerimizin de sıklıkla tercih ettiği bir stildir.',
    fit: 'Küçük, zarif ve sade bir dövme isteyenler için.',
  },
];
const faq = [
  { q: 'Sinop’ta dövme modellerini nereden seçebilirim?', a: 'Bu sayfadaki ve ana sayfamızdaki örnekleri, ayrıca Instagram hesabımızdaki güncel çalışmalarımızı inceleyebilirsiniz. Hazır bir model seçmek zorunda değilsiniz; fikrinizi bizimle paylaşmanız hâlinde size özel bir tasarım hazırlıyoruz.' },
  { q: 'İnternette bulduğum bir modeli yaptırabilir miyim?', a: 'Referans olarak getirebilirsiniz; tasarımı derinize ve yerleşime uygun hâle getirmek için birlikte düzenleriz. Ancak başka bir sanatçının özgün çalışmasını birebir kopyalamıyoruz.' },
  { q: 'Dövme fiyatları stile göre değişir mi?', a: 'Evet. Fiyatı stil, boyut, detay ve seans sayısı belirler. Küçük bir fine line çalışması ile tam kol bir realism çalışması aynı emeği gerektirmez; fikrinizi ilettiğinizde size net bir fiyat bildiririz.' },
];
---
<Guide
  slug="dovme-stilleri"
  kicker="Sinop · Dövme modelleri"
  h1="Sinop dövme modelleri ve stilleri"
  lead="Inkfade’de pek çok stilde çalışıyoruz; uzmanlık alanımız Black & Grey Realism. Aşağıdaki fotoğrafların tamamı Sinop’taki stüdyomuzda yapılmış çalışmalardır. Her stilin nasıl göründüğünü ve kimlere uygun olduğunu bu sayfada bulabilirsiniz."
  faq={faq}
>
  <p>Karar vermeden önce stillere göz atmak, size en uygun tasarımı bulmayı kolaylaştırır. <a href={base}>Inkfade Tattoo, Sinop dövme stüdyosu</a> olarak her tasarımı kişiye özel hazırlıyoruz; bu sayfadaki örnekler size fikir vermesi amacıyla paylaşılmıştır.</p>

  {styles.map((s) => (
    <section class="guide-style">
      <h2>{s.name}</h2>
      <div class="guide-gallery">
        {s.ids.map((id) => (
          <figure>
            <img src={works[id].sm} alt={`${s.name} dövme, ${works[id].place}`} loading="lazy" decoding="async" style={`object-position:${works[id].pos}`} />
            <figcaption>{works[id].place}</figcaption>
          </figure>
        ))}
      </div>
      <p>{s.text}</p>
      <p class="guide-fit"><span class="mono">Kimler için uygun</span> {s.fit}</p>
    </section>
  ))}
  <p>Daha fazla örnek için <a href={`${base}#portfolyo`}>Sinop dövmeci Ulaş Hakan’ın portfolyosunu</a> inceleyebilirsiniz. Dövmenin yanı sıra <a href={`${base}sinop-piercing/`}>Sinop piercing</a> hizmeti de sunuyoruz. İlk dövmenizi yaptıracaksanız <a href={`${base}ilk-dovme-rehberi/`}>ilk dövme rehberimiz</a> size yardımcı olacaktır.</p>
</Guide>
