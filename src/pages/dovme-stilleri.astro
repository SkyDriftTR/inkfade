---
import Guide from '../layouts/Guide.astro';
import { works } from '../data/works.js';
const base = import.meta.env.BASE_URL.endsWith('/') ? import.meta.env.BASE_URL : import.meta.env.BASE_URL + '/';
const styles = [
  {
    name: 'Black & Grey Realism',
    ids: ['zeus', 'ozgurluk', 'catrina'],
    text: 'En çok yaptığımız iş bu. Portreler, heykeller, hayvanlar, mitoloji figürleri… Siyahla grinin yumuşak geçişleriyle fotoğrafa yakın bir derinlik veriyoruz. Ön kol, üst kol, baldır, sırt gibi geniş ve düz yerlerde çok daha iyi duruyor.',
    fit: 'Detaylı, etkisi uzaktan da görünen bir parça istiyorsan.',
  },
  {
    name: 'Sleeve (tam kol, tam bacak)',
    ids: ['basmelek', 'melek-kafatasi', 'gotham'],
    text: 'Bütün kolu ya da bacağı tek bir hikâye gibi kuruyoruz. Birkaç seans sürüyor ve parçalar birbirine bağlansın diye en baştan bütün olarak planlıyoruz. Böylece sonradan eklenen parçalarla oluşan dağınık görüntü olmuyor.',
    fit: 'Büyük bir proje düşünüyorsan ve acelen yoksa.',
  },
  {
    name: 'Oriental',
    ids: ['hannya', 'foo-dog-koi'],
    text: 'Hannya maskesi, koi, foo dog gibi Uzak Doğu motiflerini kalın kontur ve black & grey gölgeyle kendi tarzımızda çiziyoruz. Üst kol ve omuz gibi kavisli yerlerde güzel akıyor.',
    fit: 'Arkasında bir anlam taşıyan, karakterli bir dövme istiyorsan.',
  },
  {
    name: 'Sketch & Dotwork',
    ids: ['kirik-heykel', 'balance', 'spiderman'],
    text: 'Eskiz çizgileri, noktayla verilen gölgeler, bilerek bırakılmış kırılmalar. Realism’e göre daha hafif duruyor; klasik bir figürü daha modern göstermek için güzel bir yol.',
    fit: 'Alışılmışın biraz dışında bir şey istiyorsan.',
  },
  {
    name: 'Fine line & Minimal',
    ids: ['lale', 'gul', 'denizanasi'],
    text: 'İnce çizgiler, küçük boyutlar, yer yer hafif renk. Bilek, ön kol, köprücük kemiği gibi yerlere yakışıyor; ilk dövmesini yaptıracaklar da çoğunlukla buradan başlıyor.',
    fit: 'Küçük ve sade bir şey istiyorsan.',
  },
];
const faq = [
  { q: 'Sinop’ta dövme modellerini nereden seçebilirim?', a: 'Bu sayfadaki ve ana sayfadaki örneklere, bir de Instagram’daki güncel işlerimize bakabilirsin. Hazır bir model seçmek zorunda değilsin; fikrini anlatırsan sana özel çizeriz.' },
  { q: 'İnternetten bulduğum bir modeli yaptırabilir miyim?', a: 'Referans olarak getir, deride ve o bölgede iyi dursun diye üzerinde birlikte oynarız. Yalnız başka bir sanatçının özgün çizimini birebir kopyalamıyoruz.' },
  { q: 'Dövme fiyatları stile göre değişir mi?', a: 'Evet. Fiyatı stil, boyut, detay ve seans sayısı belirler. Fine line küçük bir parça ile tam kol realism aynı emeği gerektirmez; fikrini gönderdiğinde net fiyat veririz.' },
];
---
<Guide
  slug="dovme-stilleri"
  kicker="Sinop · Dövme modelleri"
  h1="Sinop dövme modelleri ve stilleri"
  lead="Inkfade’de birçok stilde çalışıyoruz ama en çok uğraştığımız iş Black & Grey Realism. Aşağıdaki fotoğrafların hepsi Sinop’taki stüdyomuzda yapıldı; hangi stilin neye benzediğine buradan bakabilirsin."
  faq={faq}
>
  <p>Ne yaptıracağına karar vermeden önce stillere bir göz atmak işini kolaylaştırır. <a href={base}>Inkfade Tattoo, Sinop dövme stüdyosu</a> olarak her tasarımı o kişi için ayrıca çiziyoruz, buradakileri de fikir versin diye koyduk.</p>

  {styles.map((s) => (
    <section class="guide-style">
      <h2>{s.name}</h2>
      <div class="guide-gallery">
        {s.ids.map((id) => (
          <figure>
            <img src={works[id].sm} alt={`${s.name} dövme, ${works[id].place}`} loading="lazy" decoding="async" style={`object-position:${works[id].pos}`} />
            <figcaption>{works[id].place}</figcaption>
          </figure>
        ))}
      </div>
      <p>{s.text}</p>
      <p class="guide-fit"><span class="mono">Kime uygun</span> {s.fit}</p>
    </section>
  ))}
  <p>Daha fazla örnek için <a href={`${base}#portfolyo`}>Sinop dövmeci Ulaş Hakan’ın portfolyosuna</a> göz atabilirsin. Dövmenin yanında <a href={`${base}sinop-piercing/`}>Sinop piercing</a> hizmetimiz de var. İlk dövmeni yaptıracaksan <a href={`${base}ilk-dovme-rehberi/`}>ilk dövme rehberimiz</a> işine yarayabilir.</p>
</Guide>
