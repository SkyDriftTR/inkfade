---
import Base from '../layouts/Base.astro';
import Loader from '../components/Loader.astro';
import Nav from '../components/Nav.astro';
import Hero from '../components/Hero.astro';
import Manifesto from '../components/Manifesto.astro';
import Work from '../components/Work.astro';
import Styles from '../components/Styles.astro';
import Portfolio from '../components/Portfolio.astro';
import Piercing from '../components/Piercing.astro';
import Process from '../components/Process.astro';
import Booking from '../components/Booking.astro';
import Lightbox from '../components/Lightbox.astro';
import About from '../components/About.astro';
import Faq from '../components/Faq.astro';
import Location from '../components/Location.astro';
import Footer from '../components/Footer.astro';
import { site } from '../data/site.js';
import { faq } from '../data/faq.js';
const home = Astro.site ? new URL(import.meta.env.BASE_URL, Astro.site).href : undefined;
// Google'ın haritadaki işletmeyle siteyi eşleştirmesi için yapısal veri
const schema = {
  '@context': 'https://schema.org',
  '@type': 'TattooParlor',
  name: site.name,
  url: home,
  image: home ? new URL('og.jpg', home).href : undefined,
  telephone: site.phone.replace(/\s/g, ''),
  address: { '@type': 'PostalAddress', streetAddress: 'Camikebir, Sakarya Cd. Göçgünoğlu Pasajı D:50/10P', postalCode: '57000', addressLocality: 'Sinop Merkez', addressRegion: 'Sinop', addressCountry: 'TR' },
  geo: { '@type': 'GeoCoordinates', latitude: site.lat, longitude: site.lng },
  hasMap: site.mapsUrl,
  sameAs: [site.instagramUrl],
  founder: { '@type': 'Person', name: 'Ulaş Hakan', jobTitle: 'Tattoo Artist' },
  makesOffer: ['Dövme', 'Piercing'].map((n) => ({ '@type': 'Offer', itemOffered: { '@type': 'Service', name: n } })),
};
// SSS'ler Google'a soru-cevap olarak da bildirilir
const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faq.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })),
};
---
<Base title="Sinop Dövme ve Piercing | Inkfade Tattoo, Dövmeci Ulaş Hakan" description="Sinop Merkez'de dövme ve piercing stüdyosu. Black & grey realism, fine line ve kişiye özel dövme modelleri. Fiyat ve randevu için WhatsApp'tan yazın." schema={[schema, faqSchema]}>
  <Loader />
  <Nav />
  <Hero />
  <main>
    <Manifesto />
    <About />
    <Work />
    <Styles />
    <Portfolio />
    <Piercing />
    <Process />
    <Location />
    <Booking />
    <Faq />
  </main>
  <Footer />
  <Lightbox />
</Base>
