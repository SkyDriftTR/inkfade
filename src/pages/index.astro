---
import Base from '../layouts/Base.astro';
import Loader from '../components/Loader.astro';
import Nav from '../components/Nav.astro';
import Hero from '../components/Hero.astro';
import Manifesto from '../components/Manifesto.astro';
import Work from '../components/Work.astro';
import Styles from '../components/Styles.astro';
import Portfolio from '../components/Portfolio.astro';
import Piercing from '../components/Piercing.astro';
import Process from '../components/Process.astro';
import Booking from '../components/Booking.astro';
import Lightbox from '../components/Lightbox.astro';
---
<Base title="Ink Fade · Dövme & Piercing">
  <Loader />
  <Nav />
  <Hero />
  <main>
    <Manifesto />
    <Work />
    <Styles />
    <Portfolio />
    <Piercing />
    <Process />
    <Booking />
  </main>
  <footer>
    <div class="wrap mono"><span>© {new Date().getFullYear()} Ink Fade</span><span>Dövme & piercing stüdyosu</span></div>
  </footer>
  <Lightbox />
</Base>
