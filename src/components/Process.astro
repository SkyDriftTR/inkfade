---
const steps = [
  { n: '01', title: 'Fikir', text: 'Fikrinizi ve varsa referanslarınızı bizimle paylaşıyorsunuz. Boyutu, yerleşimi ve stili birlikte netleştiriyoruz.' },
  { n: '02', title: 'Eskiz', text: 'Size özel bir çizim hazırlıyoruz. Değiştirmek istediğiniz bir nokta olursa tasarım içinize sinene kadar düzenliyoruz.' },
  { n: '03', title: 'Seans', text: 'İğneden eldivene tüm malzemeler tek kullanımlıktır. Büyük çalışmaları, yorulmamanız için birkaç seansa bölüyoruz.' },
  { n: '04', title: 'İyileşme', text: 'Bakım talimatlarınızı yazılı olarak alıyorsunuz. Aklınıza takılan her konuda bize yazabilir ya da stüdyoya uğrayabilirsiniz.' },
];
---
<section class="process" id="surec">
  <div class="wrap">
    <p class="mono">Süreç</p>
    <h2>Fikirden deriye dört adım</h2>
    <div class="steps">
      <div class="rail" aria-hidden="true"><i></i></div>
      {steps.map((s) => (
        <div class="step"><div><span class="n">{s.n}</span><h3>{s.title}</h3></div><p>{s.text}</p></div>
      ))}
    </div>
  </div>
</section>
