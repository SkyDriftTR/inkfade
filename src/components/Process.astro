---
const steps = [
  { n: '01', title: 'Fikir', text: 'Ne istediğini anlatıyorsun, varsa referanslarını gösteriyorsun. Boyutu, yeri, stili orada konuşuyoruz.' },
  { n: '02', title: 'Eskiz', text: 'Senin için bir çizim hazırlıyoruz. Beğenmediğin bir yer olursa içine sinene kadar düzeltiyoruz.' },
  { n: '03', title: 'Seans', text: 'İğneden eldivene her şey tek kullanımlık. Büyük işleri yorulmaman için birkaç seansa bölüyoruz.' },
  { n: '04', title: 'İyileşme', text: 'Bakım notlarını alıp eve gidiyorsun. Aklına takılan bir şey olursa yazman ya da uğraman yeterli.' },
];
---
<section class="process" id="surec">
  <div class="wrap">
    <p class="mono">Süreç</p>
    <h2>Fikirden deriye dört adım</h2>
    <div class="steps">
      <div class="rail" aria-hidden="true"><i></i></div>
      {steps.map((s) => (
        <div class="step"><div><span class="n">{s.n}</span><h3>{s.title}</h3></div><p>{s.text}</p></div>
      ))}
    </div>
  </div>
</section>
