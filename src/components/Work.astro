---
import { works } from '../data/works.js';
// Uçan "Seçili İşler" kartları: works.js'teki adlarla seçilir.
const floats = [
  { id: 'zeus', left: 6, top: 4, speed: 1.4 },
  { id: 'basmelek', left: 66, top: 8, speed: 0.8 },
  { id: 'hannya', left: 38, top: 20, speed: 1.9, hideSm: true },
  { id: 'vampir', left: 14, top: 34, speed: 1.1 },
  { id: 'misir', left: 72, top: 38, speed: 1.6 },
  { id: 'catrina', left: 44, top: 52, speed: 0.7, hideSm: true },
  { id: 'ozgurluk', left: 4, top: 64, speed: 1.7 },
  { id: 'anubis', left: 60, top: 70, speed: 1.2 },
].map((f) => ({ ...f, w: works[f.id] }));
// telefonda görünen kartlar sırayla sol / sağ dizilir
let n = 0;
floats.forEach((f) => { if (!f.hideSm) f.side = n++ % 2 ? 'sm-r' : 'sm-l'; });
---
<section class="work" id="isler" aria-label="Seçili işler">
  <div class="work-title">
    <div>
      <h2>Works</h2>
      <p class="mono">Ulaş Hakan'ın son çalışmalarından</p>
    </div>
  </div>
  {floats.map((f) => (
    <figure class:list={['float', { 'hide-sm': f.hideSm }, f.side]} style={`left:${f.left}%;top:${f.top}%`} data-speed={f.speed}>
      <img src={f.w.sm} alt={`${f.w.title} dövmesi, ${f.w.place}`} loading="lazy" decoding="async" style={`object-position:${f.w.pos}`} />
      <figcaption><span>{f.w.title}</span><span>{f.w.place}</span></figcaption>
    </figure>
  ))}
</section>
