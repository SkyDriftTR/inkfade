---
import { works } from '../data/works.js';
// Uçan "Seçili İşler" kartları: works.js'teki adlarla seçilir.
const floats = [
// top değerleri bölüm yüksekliğine göre %; son kartlar dibe yakın ki bölüm son kartla birlikte bitsin
  { id: 'zeus', left: 6, top: 5, speed: 1.4 },
  { id: 'basmelek', left: 66, top: 10, speed: 0.8 },
  { id: 'hannya', left: 38, top: 24, speed: 1.9, hideSm: true },
  { id: 'vampir', left: 14, top: 41, speed: 1.1 },
  { id: 'misir', left: 72, top: 46, speed: 1.6 },
  { id: 'catrina', left: 44, top: 63, speed: 0.7, hideSm: true },
  { id: 'ozgurluk', left: 4, top: 78, speed: 1.7 },
  { id: 'anubis', left: 60, top: 85, speed: 1.2 },
].map((f) => ({ ...f, w: works[f.id] }));
// telefonda görünen kartlar sırayla sol / sağ dizilir
let n = 0;
floats.forEach((f) => { if (!f.hideSm) f.side = n++ % 2 ? 'sm-r' : 'sm-l'; });
---
<section class="work" id="isler" aria-label="Seçili işler">
  <div class="work-title">
    <div>
      <h2>Works</h2>
      <p class="mono">Ulaş Hakan’ın son çalışmalarından bir seçki</p>
    </div>
  </div>
  {floats.map((f) => (
    <figure class:list={['float', { 'hide-sm': f.hideSm }, f.side]} style={`left:${f.left}%;top:${f.top}%`} data-speed={f.speed}>
      <img src={f.w.sm} alt={`Dövme, ${f.w.place}`} loading="lazy" decoding="async" style={`object-position:${f.w.pos}`} />
      <figcaption>{f.w.place}</figcaption>
    </figure>
  ))}
</section>
