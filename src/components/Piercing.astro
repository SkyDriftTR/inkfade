---
import { groups } from '../data/piercing.js';
const base = import.meta.env.BASE_URL.endsWith('/') ? import.meta.env.BASE_URL : import.meta.env.BASE_URL + '/';
---
<section class="piercing" id="piercing">
  <div class="wrap pc-grid">
    <div class="pc-side">
      <p class="mono">Piercing</p>
      <h2>Piercing</h2>
      <p class="lede"><a class="inline-link" href={`${base}sinop-piercing/`}>Kulaktan buruna</a> çoğu piercing’i yapıyoruz. Önce kulağına, yüzüne bakıp en iyi nerede duracağını birlikte buluyoruz.</p>
      <div class="pc-notes">
        <div><p class="mono">Takı</p><p>İlk takılar 316L cerrahi çelik.</p></div>
        <div><p class="mono">Uygulama</p><p>Tek kullanımlık steril iğneyle. Tabanca kullanmıyoruz.</p></div>
        <div><p class="mono">Bakım</p><p>Eve bakım notlarıyla gidiyorsun, iyileşene kadar kontrol ücretsiz.</p></div>
      </div>
      <a class="pc-cta" href="#randevu">Piercing randevusu →</a>
    </div>
    <div class="pc-lists">
      {groups.map((g) => (
        <div class="pc-group">
          <p class="mono"><span>{g.name}</span><span>Ort. iyileşme</span></p>
          <ul class="pc-list">
            {g.items.map((it) => (
              <li>
                <span class="nm">{it.name}{it.note && <small>{it.note}</small>}</span>
                <span class="t">{it.time}</span>
              </li>
            ))}
          </ul>
        </div>
      ))}
    </div>
  </div>
</section>
