---
import { site } from '../data/site.js';
import pin from '../assets/logo-hero.webp';
// Harita, bölüm ekrana yaklaşınca yüklenir (src/scripts/map.js). Renkler sitenin paletine göre baştan boyanır.
---
<section class="location" id="konum">
  <div class="wrap loc-head">
    <div>
      <p class="mono">Konum</p>
      <h2>Bizi bul</h2>
    </div>
    <p>Sinop Merkez’de, Göçgünoğlu Pasajı’ndayız. Gelmeden önce WhatsApp’tan haber verirsen stüdyoda olduğumuzdan emin olursun.</p>
  </div>
  <div class="map-full">
    <div class="map-frame">
      <div class="map" id="map" data-lat={site.lat} data-lng={site.lng} data-pin={pin.src} aria-label="Inkfade stüdyosunun haritadaki konumu"></div>
      <div class="map-card">
        <p class="map-card-title"><svg class="map-card-mark" viewBox="0 0 682 230" role="img" aria-label="Inkfade"><use href="#inkfade-wordmark" width="682" height="230"></use></svg><span>Tattoo &amp; Piercing</span></p>
        <address class="map-card-sub">{site.address}</address>
        <div class="map-card-actions">
          <a href={site.directionsUrl} target="_blank" rel="noopener">Yol tarifi al →</a>
          <a href={site.mapsUrl} target="_blank" rel="noopener">Google Maps'te aç</a>
        </div>
      </div>
      <p class="map-fallback">Harita yüklenemedi. <a href={site.mapsUrl} target="_blank" rel="noopener">Konumu Google Maps'te aç</a></p>
    </div>
  </div>
</section>
