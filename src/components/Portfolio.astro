---
import { categories, itemsOf } from '../data/portfolio.js';
const rows = categories.map((cat, ci) => ({ cat, ci, items: itemsOf(cat, ci) }));
const isPlaceholder = (row) => !row.cat.images.length;
---
<section class="portfolio" id="portfolyo">
  <div class="wrap pf-head">
    <div>
      <p class="mono">Arşiv</p>
      <h2>Portfolyo</h2>
      <p class="mono drag-hint" style="margin-top:14px"><i></i>Sürükle · tıkla, büyüt</p>
    </div>
    <div class="chips">
      {rows.map(({ cat, items }) => (
        <button class="chip" type="button" data-go={`pf-${cat.slug}`}>{cat.name}<b>{items.length}</b></button>
      ))}
    </div>
  </div>

  {rows.map((row) => (
    <div class="pf-row" id={`pf-${row.cat.slug}`} data-name={row.cat.name}>
      <div class="wrap pf-row-head">
        <div>
          <h3>{row.cat.name}</h3>
          <span class="mono">{row.items.length} iş{isPlaceholder(row) ? ' · örnek görseller' : ''}</span>
        </div>
        <div class="pf-ctrl">
          <button type="button" data-dir="-1" aria-label={`${row.cat.name}: önceki`}><svg viewBox="0 0 16 16" aria-hidden="true"><path d="M10 3L5 8l5 5"></path></svg></button>
          <button type="button" data-dir="1" aria-label={`${row.cat.name}: sonraki`}><svg viewBox="0 0 16 16" aria-hidden="true"><path d="M6 3l5 5-5 5"></path></svg></button>
        </div>
      </div>
      <div class="pf-track">
        {row.items.map((it, i) => (
          <button class="pf-item" type="button" data-i={i} data-tag={it.tag} aria-label={`${row.cat.name} ${i + 1}, ${it.tag}`}>
            {it.src
              ? <img src={it.src} alt={`${row.cat.name}, ${it.tag}`} loading="lazy" />
              : <canvas data-mode={it.mode} data-seed={it.seed} data-lazy></canvas>}
            <span><b style="font-weight:400">{String(i + 1).padStart(2, '0')}</b><em style="font-style:normal">{it.tag}</em></span>
          </button>
        ))}
      </div>
    </div>
  ))}
</section>
