---
import logo from '../assets/logo-hero.webp';
import logoSoft from '../assets/logo-hero-soft.webp';
---
<header class="hero" id="top">
  <canvas id="smoke" aria-hidden="true"></canvas>
  <div class="hero-vignette"></div>
  <div class="hero-inner">
    <div class="logo">
      <div class="logo-inner">
        <img class="logo-sharp" src={logo.src} width="640" height="640" alt="Inkfade logosu" />
        <img class="logo-soft" src={logoSoft.src} width="720" height="720" alt="" aria-hidden="true" />
        <img class="logo-intro" src={logoSoft.src} width="720" height="720" alt="" aria-hidden="true" />
      </div>
    </div>
    <div class="hero-copy">
      <p class="mono">Black &amp; Grey Realism · Piercing · Sinop</p>
      <h1 class="hero-tag">Tattoo <em>&amp; Piercing</em></h1>
    </div>
  </div>
  <div class="scroll-hint mono"><span>Kaydır</span><i></i></div>
</header>
