---
import logo from '../assets/logo.webp';
---
<header class="hero" id="top">
  <canvas id="smoke" aria-hidden="true"></canvas>
  <div class="hero-vignette"></div>
  <div class="hero-inner">
    <div class="logo"><div class="logo-inner"><img src={logo.src} width="560" height="560" alt="Ink Fade logosu" /></div></div>
    <div class="hero-copy">
      <p class="mono">Black &amp; Grey Realism · Piercing · Sinop</p>
      <h1 class="hero-tag">Tattoo <em>&amp; Piercing</em></h1>
    </div>
  </div>
  <div class="scroll-hint mono"><span>Kaydır</span><i></i></div>
</header>
