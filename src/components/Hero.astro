---
import logo from '../assets/logo.webp';
---
<header class="hero" id="top">
  <canvas id="smoke" aria-hidden="true"></canvas>
  <div class="hero-vignette"></div>
  <div class="hero-inner">
    <div class="logo"><img src={logo.src} width="560" height="560" alt="Ink Fade logosu" /></div>
    <div class="hero-copy">
      <p class="mono">Dövme · Piercing · Özel tasarım</p>
      <h1 class="hero-tag">Mürekkep kalır, <em>gerisi solar.</em></h1>
    </div>
  </div>
  <div class="scroll-hint mono"><span>Kaydır</span><i></i></div>
</header>
