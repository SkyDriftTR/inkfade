---
const text = 'Önce sizinle oturup konuşuruz. Ne anlatmak istediğinizi ve tasarımın nereye yakışacağını dinler, ardından yalnızca size ait bir çizim hazırlarız. Aynı dövmeyi ikinci kez yapmayız.';
const accent = ['yalnızca', 'size'];
const words = text.split(' ');
---
<section class="manifesto">
  <div class="wrap">
    <p class="big" id="manifesto">
      {words.map((w) => (
        <><span class:list={['w', { blue: accent.some((a) => w.toLowerCase().startsWith(a)) }]}>{w}</span>{' '}</>
      ))}
    </p>
  </div>
</section>

