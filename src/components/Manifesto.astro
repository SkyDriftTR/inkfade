---
const text = 'Her dövme deride başlamadan önce kâğıtta başlar. Senin hikâyeni dinler, sana ait tek bir çizim çıkarırız. Aynısı bir daha yapılmaz.';
const accent = ['tek', 'sana'];
const words = text.split(' ');
---
<section class="manifesto">
  <div class="wrap">
    <p class="big" id="manifesto">
      {words.map((w) => (
        <><span class:list={['w', { blue: accent.some((a) => w.toLowerCase().startsWith(a)) }]}>{w}</span>{' '}</>
      ))}
    </p>
  </div>
</section>

<section class="pillars" aria-label="Stüdyo ilkeleri">
  <div class="wrap pillars-grid">
    <div><h3>Özel tasarım</h3><p>Hazır katalogdan değil, seninle konuşarak çizilen eskizler. Onaylamadan iğne değmez.</p></div>
    <div><h3>Piercing</h3><p>316L cerrahi çelik takılar ve iğneyle yapılan uygulama. Tabanca kullanılmaz.</p></div>
    <div><h3>Hijyen</h3><p>Tek kullanımlık iğne ve kartuşlar, her seans sonrası sterilizasyon.</p></div>
  </div>
</section>
