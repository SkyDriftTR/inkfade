---
const text = 'Önce oturup konuşuruz. Ne anlatmak istediğini, nereye yakışacağını dinler, sonra sadece sana ait bir çizim hazırlarız. Aynı dövmeyi ikinci kez yapmayız.';
const accent = ['sadece', 'sana'];
const words = text.split(' ');
---
<section class="manifesto">
  <div class="wrap">
    <p class="big" id="manifesto">
      {words.map((w) => (
        <><span class:list={['w', { blue: accent.some((a) => w.toLowerCase().startsWith(a)) }]}>{w}</span>{' '}</>
      ))}
    </p>
  </div>
</section>

<section class="pillars" aria-label="Stüdyo ilkeleri">
  <div class="wrap pillars-grid">
    <div><h3>Özel tasarım</h3><p>Katalogdan model seçtirmiyoruz. Eskizi konuşa konuşa birlikte çıkarıyoruz, içine sinmeden başlamıyoruz.</p></div>
    <div><h3>Piercing</h3><p>Tabancayla değil, iğneyle yapıyoruz. İlk takın 316L cerrahi çelik oluyor.</p></div>
    <div><h3>Hijyen</h3><p>İğne ve kartuşlar tek kullanımlık. Her seanstan sonra çalışma alanı baştan steril ediliyor.</p></div>
  </div>
</section>
