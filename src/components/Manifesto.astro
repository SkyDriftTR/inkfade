---
const text = 'Her dövme deride başlamadan önce kâğıtta başlar. Senin hikâyeni dinler, sana ait tek bir çizim çıkarırız. Aynısı bir daha yapılmaz.';
const accent = ['tek', 'sana'];
const words = text.split(' ');
---
<section class="manifesto">
  <div class="wrap">
    <p class="mono">Stüdyo</p>
    <p class="big" id="manifesto">
      {words.map((w) => (
        <><span class:list={['w', { blue: accent.some((a) => w.toLowerCase().startsWith(a)) }]}>{w}</span>{' '}</>
      ))}
    </p>
    <div class="meta">
      <div><p class="mono">Özel tasarım</p><p>Hazır katalogdan değil, seninle konuşarak çizilen eskizler. Onaylamadan iğne değmez.</p></div>
      <div><p class="mono">Piercing</p><p>316L cerrahi çelik takılar ve iğneyle yapılan uygulama. Tabanca kullanılmaz.</p></div>
      <div><p class="mono">Hijyen</p><p>Tek kullanımlık iğne ve kartuşlar, her seans sonrası sterilizasyon.</p></div>
    </div>
  </div>
</section>
