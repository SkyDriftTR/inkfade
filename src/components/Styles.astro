---
import { works } from '../data/works.js';
const styles = [
  { name: 'Black & Grey Realism', tag: 'Uzmanlık alanı', id: 'zeus', text: 'Portre, heykel ve hayvan figürleri. Yumuşak gölge geçişleri ve derinlikle fotoğraf gerçekliği.' },
  { name: 'Sleeve', tag: 'Tam kol · tam bacak', id: 'basmelek', text: 'Kol ya da bacak boyunca tek bir hikâye anlatan, alanı bütün olarak kullanan büyük kompozisyonlar.' },
  { name: 'Oriental', tag: 'Hannya · koi', id: 'hannya', text: 'Uzak Doğu motiflerinin güçlü konturlar ve black & grey gölgeyle yorumu.' },
  { name: 'Sketch & Dotwork', tag: 'Çizgi · nokta', id: 'balance', text: 'Eskiz çizgileri, nokta gölgeleme ve grafik kırılmalarla daha deneysel işler.' },
  { name: 'Fine line', tag: 'İnce çizgi · renk', id: 'lale', text: 'Küçük, zarif parçalar. Tek çizgiler, yumuşak renk geçişleri ve minimal detay.' },
].map((s) => ({ ...s, w: works[s.id] }));
---
<section class="styles" id="stiller">
  <div class="wrap styles-head">
    <div><p class="mono">Uzmanlık</p><h2>Stiller</h2></div>
    <p>Farklı stillerde çalışıyoruz; odak noktamız Black & Grey Realism. Hangisinin sana uyduğunu ilk görüşmede birlikte seçeriz.</p>
  </div>
  <p class="mono swipe-hint" aria-hidden="true">← Kaydırarak gez →</p>
  <div class="track">
    {styles.map((s) => (
      <article class="panel">
        <div class="art"><img src={s.w.sm} alt={`${s.name} örneği: ${s.w.title}`} loading="lazy" decoding="async" style={`object-position:${s.w.pos}`} /></div>
        <h3>{s.name} <span class="mono">{s.tag}</span></h3>
        <p>{s.text}</p>
      </article>
    ))}
  </div>
  <div class="progress" aria-hidden="true"><i></i></div>
</section>
