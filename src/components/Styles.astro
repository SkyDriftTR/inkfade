---
import { works } from '../data/works.js';
import { base } from '../lib/url.js';

const styles = [
  { name: 'Black & Grey Realism', tag: 'Uzmanlık alanı', id: 'zeus', text: 'Portreler, heykeller, hayvanlar. Gölgeleri yavaş yavaş kurup fotoğraftaki derinliği deriye taşımaya çalışıyoruz.' },
  { name: 'Sleeve', tag: 'Tam kol · tam bacak', id: 'basmelek', text: 'Bütün kolu ya da bacağı tek bir hikâye gibi düşünüyoruz. Parçalar birbirine bağlansın diye işi en baştan bütün olarak planlıyoruz.' },
  { name: 'Oriental', tag: 'Hannya · koi', id: 'hannya', text: 'Hannya, koi, foo dog… Uzak Doğu motiflerini kalın kontur ve black & grey gölgeyle kendi tarzımızda yorumluyoruz.' },
  { name: 'Sketch & Dotwork', tag: 'Çizgi · nokta', id: 'balance', text: 'Eskiz çizgileri, noktayla verilen gölgeler, yer yer bilerek bırakılmış kırılmalar. Biraz daha deneysel işler.' },
  { name: 'Fine line', tag: 'İnce çizgi · renk', id: 'lale', text: 'Küçük, ince, sade parçalar. İlk dövmesini yaptıracak olanlar çoğu zaman buradan başlıyor.' },
].map((s) => ({ ...s, w: works[s.id] }));
---
<section class="styles" id="stiller">
  <div class="wrap styles-head">
    <div><p class="mono">Uzmanlık</p><h2>Stiller</h2></div>
    <p><a class="inline-link" href={`${base}dovme-stilleri/`}>Birçok stilde</a> çalışıyoruz ama en çok uğraştığımız iş Black & Grey Realism. Sana hangisinin yakışacağına ilk görüşmede birlikte karar veririz.</p>
  </div>
  <p class="mono swipe-hint" aria-hidden="true">← Kaydırarak gez →</p>
  <div class="track">
    {styles.map((s) => (
      <article class="panel">
        <div class="art"><img src={s.w.sm} alt={`${s.name} dövme örneği, ${s.w.place}`} loading="lazy" decoding="async" style={`object-position:${s.w.pos}`} /></div>
        <h3>{s.name} <span class="mono">{s.tag}</span></h3>
        <p>{s.text}</p>
      </article>
    ))}
  </div>
  <div class="progress" aria-hidden="true"><i></i></div>
</section>
