---
import { works } from '../data/works.js';
const styles = [
  { name: 'Black & Grey Realism', tag: 'Uzmanlık alanı', id: 'zeus', text: 'Portre, heykel ve hayvan figürleri. Gölgeleri katman katman kurarak fotoğraftaki derinliği deriye taşıyoruz.' },
  { name: 'Sleeve', tag: 'Tam kol · tam bacak', id: 'basmelek', text: 'Kolun ya da bacağın tamamını tek bir hikâye olarak kurguluyor, parçaların birbirine bağlanması için tasarımı en baştan bütün olarak planlıyoruz.' },
  { name: 'Oriental', tag: 'Hannya · koi', id: 'hannya', text: 'Hannya, koi ve foo dog gibi Uzak Doğu motiflerini güçlü konturlar ve black & grey gölgelendirmeyle kendi yorumumuzla çiziyoruz.' },
  { name: 'Sketch & Dotwork', tag: 'Çizgi · nokta', id: 'balance', text: 'Eskiz çizgileri, nokta gölgelendirme ve bilinçli bırakılan kırılmalarla daha deneysel çalışmalar.' },
  { name: 'Fine line', tag: 'İnce çizgi · renk', id: 'lale', text: 'Küçük, ince ve sade çalışmalar. İlk dövmesini yaptıracak misafirlerimizin sıklıkla tercih ettiği bir stil.' },
].map((s) => ({ ...s, w: works[s.id] }));
const base = import.meta.env.BASE_URL.endsWith('/') ? import.meta.env.BASE_URL : import.meta.env.BASE_URL + '/';
---
<section class="styles" id="stiller">
  <div class="wrap styles-head">
    <div><p class="mono">Uzmanlık</p><h2>Stiller</h2></div>
    <p><a class="inline-link" href={`${base}dovme-stilleri/`}>Pek çok stilde</a> çalışıyoruz; uzmanlık alanımız Black & Grey Realism. Size en uygun stile ilk görüşmede birlikte karar veriyoruz.</p>
  </div>
  <p class="mono swipe-hint" aria-hidden="true">← Kaydırarak gezin →</p>
  <div class="track">
    {styles.map((s) => (
      <article class="panel">
        <div class="art"><img src={s.w.sm} alt={`${s.name} dövme örneği, ${s.w.place}`} loading="lazy" decoding="async" style={`object-position:${s.w.pos}`} /></div>
        <h3>{s.name} <span class="mono">{s.tag}</span></h3>
        <p>{s.text}</p>
      </article>
    ))}
  </div>
  <div class="progress" aria-hidden="true"><i></i></div>
</section>
