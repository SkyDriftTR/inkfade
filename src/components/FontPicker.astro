---
// GEÇİCİ: başlık fontlarını karşılaştırmak için. Karar verilince bu bileşeni ve
// Base.astro'daki <FontPicker /> satırını sil, global.css'te --f-head'i seçilen fonta ayarla.
const fonts = [
  { id: 'grenze', name: 'Grenze Gotisch', family: "'Grenze Gotisch'", weight: 600 },
  { id: 'pirata', name: 'Pirata One', family: "'Pirata One'", weight: 400 },
  { id: 'cook', name: 'UnifrakturCook', family: "'UnifrakturCook'", weight: 700 },
  { id: 'maguntia', name: 'UnifrakturMaguntia', family: "'UnifrakturMaguntia'", weight: 400 },
];
---
<div class="fontpick" id="fontpick" role="group" aria-label="Başlık fontu seç">
  <p><b class="aa">Aa</b><span>Başlık fontu · karşılaştırma</span><button type="button" id="fpToggle" aria-label="Paneli küçült">–</button></p>
  <div class="opts">
    {fonts.map((f) => (
      <button type="button" data-font={f.id} aria-pressed="false" style={`font-family:${f.family},serif;font-weight:${f.weight}`}>{f.name}</button>
    ))}
  </div>
</div>

<script>
  import { ScrollTrigger } from 'gsap/ScrollTrigger';
  const root = document.documentElement;
  const panel = document.getElementById('fontpick');
  const btns = [...panel.querySelectorAll('.opts button')];
  const current = () => root.dataset.font || 'grenze';
  const sync = () => btns.forEach((b) => b.setAttribute('aria-pressed', String(b.dataset.font === current())));
  btns.forEach((b) => b.addEventListener('click', () => {
    if (b.dataset.font === 'grenze') delete root.dataset.font; else root.dataset.font = b.dataset.font;
    try { localStorage.setItem('inkfade-font', b.dataset.font); } catch (e) {}
    sync();
    // başlık boyutları değişince scroll animasyonlarının ölçülerini yenile
    document.fonts.ready.then(() => ScrollTrigger.refresh());
  }));
  const toggle = document.getElementById('fpToggle');
  toggle.addEventListener('click', () => {
    const min = panel.classList.toggle('min');
    toggle.textContent = min ? '+' : '–';
    toggle.setAttribute('aria-label', min ? 'Paneli aç' : 'Paneli küçült');
  });
  if (matchMedia('(max-width:720px)').matches) toggle.click();
  sync();
</script>
