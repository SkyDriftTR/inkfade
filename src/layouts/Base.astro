---
import '../styles/global.css';
import Wordmark from '../components/Wordmark.astro';
const base = import.meta.env.BASE_URL.endsWith('/') ? import.meta.env.BASE_URL : import.meta.env.BASE_URL + '/';
const { schema = null, home = true, title = 'Ink Fade', description = 'Inkfade Tattoo & Piercing, Sinop Merkez. Ulaş Hakan ile Black & Grey Realism, sleeve, fine line dövme ve piercing.' } = Astro.props;
// Adresler: SITE/BASE GitHub Pages ayarından gelir; özel domain eklenince kendiliğinden https://inkfadetattoo.com olur.
const canonical = Astro.site ? new URL(Astro.url.pathname, Astro.site).href : null;
const ogImage = Astro.site ? new URL(`${base}og.jpg`, Astro.site).href : `${base}og.jpg`;
// Fontlar sitenin içinden yüklenir: ziyaretçinin IP'si Google'a gitmez (KVKK), çerez yok.
const f = (n) => `${base}fonts/${n}.woff`;
const fontCss = [
  ['Pirata One', 'pirata-one', 'normal', '400'],
  ['Grenze', 'grenze', 'normal', '400 600'],
  ['Grenze', 'grenze-italic', 'italic', '400'],
  ['Instrument Sans', 'instrument-sans', 'normal', '400 600'],
].map(([fam, file, style, w]) => `@font-face{font-family:"${fam}";src:url(${f(file)}) format("woff");font-style:${style};font-weight:${w};font-display:swap}`).join('');
---
<!doctype html>
<html lang="tr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#06070c" />
    <link rel="icon" href={`${base}favicon.ico`} sizes="any" />
    <link rel="icon" type="image/png" sizes="32x32" href={`${base}favicon-32.png`} />
    <link rel="icon" type="image/png" sizes="16x16" href={`${base}favicon-16.png`} />
    <link rel="apple-touch-icon" href={`${base}apple-touch-icon.png`} />
    {canonical && <link rel="canonical" href={canonical} />}
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="tr_TR" />
    <meta property="og:site_name" content="Inkfade Tattoo & Piercing" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    {canonical && <meta property="og:url" content={canonical} />}
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={ogImage} />
    {schema && <script type="application/ld+json" set:html={JSON.stringify(schema)} />}
    <link rel="preload" href={`${base}fonts/pirata-one.woff`} as="font" type="font/woff" crossorigin />
    <style is:inline set:html={fontCss}></style>
    <script is:inline>
      document.documentElement.classList.add('js');
    </script>
  </head>
  <body>
    <Wordmark />
    <div class="grain" aria-hidden="true"></div>
    {home && <div class="cursor" aria-hidden="true"></div>}
    <slot />
    {home && <a class="fab" href="#randevu"><i></i>Randevu</a>}
    {home && <script>
      import '../scripts/main.js';
    </script>}
  </body>
</html>
