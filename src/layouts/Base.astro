---
import '../styles/global.css';
const { title = 'Ink Fade', description = 'Ink Fade dövme ve piercing stüdyosu. Özel tasarım dövme, cover-up ve piercing.' } = Astro.props;
---
<!doctype html>
<html lang="tr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#06070c" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Cinzel:wght@400;600&family=Instrument+Sans:wght@400;500;600&family=JetBrains+Mono:wght@400;500&display=swap" />
    <script is:inline>document.documentElement.classList.add('js')</script>
  </head>
  <body>
    <div class="grain" aria-hidden="true"></div>
    <div class="cursor" aria-hidden="true"></div>
    <slot />
    <a class="fab" href="#randevu"><i></i>Randevu</a>
    <script>
      import '../scripts/main.js';
    </script>
  </body>
</html>
